{
    "name": "openchamber-dcp-rc-stats",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-or-later",
    "description": "OpenChamber extension: DCP RC compression stats in a side panel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/royalcat/openchamber-dcp-rc-stats.git"
    },
    "openchamber": {
        "apiVersion": 1,
        "engines": {
            "openchamber": ">=2.0.4"
        },
        "contributes": {
            "panel": {
                "id": "dcp-rc-stats",
                "name": "DCP Stats",
                "icon": "icon.svg",
                "entry": "panel/index.html"
            },
            "statusSection": {
                "entry": "panel/index.html",
                "title": "DCP",
                "height": 84
            },
            "service": {
                "entry": "service/main.js",
                "runtime": "host"
            }
        }
    },
    "scripts": {
        "build": "bun run build:panel && bun run build:service",
        "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
        "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "smoke": "node scripts/smoke.mjs"
    },
    "dependencies": {
        "@openchamber/sdk": "^2.1.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.2"
    }
}
